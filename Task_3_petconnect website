<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PawConnect | Find a Friend, Save a Life</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .hero-gradient { background: linear-gradient(135deg, #FFEDD5 0%, #FEE2E2 100%); }
        .card-hover:hover { transform: translateY(-10px); transition: all 0.3s ease; }
        .glass { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">

    <!-- Navigation -->
    <nav class="fixed w-full z-50 glass border-b border-orange-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <div class="flex items-center gap-2">
                    <i class="fas fa-paw text-orange-500 text-3xl"></i>
                    <span class="text-2xl font-bold bg-gradient-to-r from-orange-600 to-red-500 bg-clip-text text-transparent">PETCONNECT</span>
                </div>
                <div class="hidden md:flex space-x-8 font-medium">
                    <a href="#home" class="hover:text-orange-500 transition">Home</a>
                    <a href="#pets" class="hover:text-orange-500 transition">Adopt</a>
                    <a href="#process" class="hover:text-orange-500 transition">Process</a>
                    <a href="#tips" class="hover:text-orange-500 transition">Pet Care</a>
                    <a href="#donate" class="bg-orange-500 text-white px-5 py-2 rounded-full hover:bg-orange-600 transition">Donate</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- 1. Hero Section -->
    <section id="home" class="pt-32 pb-20 hero-gradient min-h-screen flex items-center">
        <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <span class="bg-orange-100 text-orange-600 px-4 py-1 rounded-full text-sm font-bold tracking-wide uppercase">Adopt, Don't Shop</span>
                <h1 class="text-5xl md:text-7xl font-bold leading-tight">Find Your New <br><span class="text-orange-500">Best Friend</span></h1>
                <p class="text-lg text-slate-600">Every pet deserves a loving home. Join thousands of families who found their perfect companion through PawConnect.</p>
                <div class="flex flex-wrap gap-4">
                    <a href="#pets" class="bg-orange-500 text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-orange-600 shadow-lg shadow-orange-200 transition">Adopt a Pet</a>
                    <a href="#about" class="bg-white border-2 border-orange-100 px-8 py-4 rounded-2xl font-bold text-lg hover:border-orange-500 transition">Learn More</a>
                </div>
            </div>
            <div class="relative">
                <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-2xl shadow-xl z-10 animate-bounce">
                    <p class="text-sm font-bold">🐶 1,200+ Pets Adopted</p>
                </div>
                <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&q=80&w=800" alt="Happy Golden Retriever" class="rounded-[3rem] shadow-2xl">
            </div>
        </div>
    </section>

    <!-- 2. Available Pets -->
    <section id="pets" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Meet Your Future Friend</h2>
                <p class="text-slate-500">Waiting for a home and a heart like yours</p>
                <div class="flex justify-center gap-4 mt-8">
                    <button class="bg-orange-500 text-white px-6 py-2 rounded-full">All</button>
                    <button class="bg-slate-100 hover:bg-orange-100 px-6 py-2 rounded-full transition">Dogs</button>
                    <button class="bg-slate-100 hover:bg-orange-100 px-6 py-2 rounded-full transition">Cats</button>
                </div>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Pet Card 1 -->
                <div class="card-hover bg-slate-50 rounded-[2rem] overflow-hidden shadow-sm border border-slate-100">
                    <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&q=80&w=600" alt="Dog" class="w-full h-64 object-cover">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="text-2xl font-bold">Cooper</h3>
                            <span class="text-orange-500 font-bold">2 Yrs</span>
                        </div>
                        <p class="text-slate-500 mb-4"><i class="fas fa-map-marker-alt mr-2"></i>California, USA</p>
                        <div class="flex gap-2 mb-6 text-xs uppercase font-bold">
                            <span class="bg-blue-100 text-blue-600 px-3 py-1 rounded-md">Golden Retriever</span>
                        </div>
                        <button class="w-full bg-white border-2 border-orange-500 text-orange-500 py-3 rounded-xl font-bold hover:bg-orange-500 hover:text-white transition">View Profile</button>
                    </div>
                </div>

                <!-- Pet Card 2 -->
                <div class="card-hover bg-slate-50 rounded-[2rem] overflow-hidden shadow-sm border border-slate-100">
                    <img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&q=80&w=600" alt="Cat" class="w-full h-64 object-cover">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="text-2xl font-bold">Luna</h3>
                            <span class="text-orange-500 font-bold">6 Mos</span>
                        </div>
                        <p class="text-slate-500 mb-4"><i class="fas fa-map-marker-alt mr-2"></i>New York, USA</p>
                        <div class="flex gap-2 mb-6 text-xs uppercase font-bold">
                            <span class="bg-purple-100 text-purple-600 px-3 py-1 rounded-md">Siamese Mix</span>
                        </div>
                        <button class="w-full bg-white border-2 border-orange-500 text-orange-500 py-3 rounded-xl font-bold hover:bg-orange-500 hover:text-white transition">View Profile</button>
                    </div>
                </div>

                <!-- Pet Card 3 -->
                <div class="card-hover bg-slate-50 rounded-[2rem] overflow-hidden shadow-sm border border-slate-100">
                    <img src="https://images.unsplash.com/photo-1537151608828-ea2b11777ee8?auto=format&fit=crop&q=80&w=600" alt="Dog" class="w-full h-64 object-cover">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="text-2xl font-bold">Bella</h3>
                            <span class="text-orange-500 font-bold">4 Yrs</span>
                        </div>
                        <p class="text-slate-500 mb-4"><i class="fas fa-map-marker-alt mr-2"></i>Austin, TX</p>
                        <div class="flex gap-2 mb-6 text-xs uppercase font-bold">
                            <span class="bg-green-100 text-green-600 px-3 py-1 rounded-md">French Bulldog</span>
                        </div>
                        <button class="w-full bg-white border-2 border-orange-500 text-orange-500 py-3 rounded-xl font-bold hover:bg-orange-500 hover:text-white transition">View Profile</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. About Us -->
    <section id="about" class="py-24 bg-orange-50">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center gap-16">
            <div class="md:w-1/2">
                <img src="https://images.unsplash.com/photo-1415369629372-26f2fe60c767?auto=format&fit=crop&q=80&w=800" class="rounded-[2.5rem] shadow-xl" alt="About PawConnect">
            </div>
            <div class="md:w-1/2 space-y-6">
                <h2 class="text-4xl font-bold">Our Mission</h2>
                <p class="text-lg text-slate-600 leading-relaxed">At PawConnect, we believe that every animal deserves a second chance. We act as a bridge between high-quality shelters and compassionate individuals seeking a new family member.</p>
                <div class="grid grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-2xl">
                        <h4 class="text-3xl font-bold text-orange-500">10k+</h4>
                        <p class="text-sm text-slate-500">Animals Saved</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl">
                        <h4 class="text-3xl font-bold text-orange-500">500+</h4>
                        <p class="text-sm text-slate-500">Partner Shelters</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Adoption Process -->
    <section id="process" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16">How It Works</h2>
            <div class="grid md:grid-cols-4 gap-8">
                <div class="text-center group">
                    <div class="w-20 h-20 bg-orange-100 text-orange-600 rounded-3xl flex items-center justify-center text-3xl mb-6 mx-auto group-hover:bg-orange-500 group-hover:text-white transition duration-500">1</div>
                    <h3 class="text-xl font-bold mb-2">Find a Friend</h3>
                    <p class="text-slate-500">Browse our list of lovable pets waiting for a home.</p>
                </div>
                <div class="text-center group">
                    <div class="w-20 h-20 bg-orange-100 text-orange-600 rounded-3xl flex items-center justify-center text-3xl mb-6 mx-auto group-hover:bg-orange-500 group-hover:text-white transition duration-500">2</div>
                    <h3 class="text-xl font-bold mb-2">Meet & Greet</h3>
                    <p class="text-slate-500">Schedule a visit to spend time with your potential pet.</p>
                </div>
                <div class="text-center group">
                    <div class="w-20 h-20 bg-orange-100 text-orange-600 rounded-3xl flex items-center justify-center text-3xl mb-6 mx-auto group-hover:bg-orange-500 group-hover:text-white transition duration-500">3</div>
                    <h3 class="text-xl font-bold mb-2">Interview</h3>
                    <p class="text-slate-500">A quick chat to ensure a perfect match for both of you.</p>
                </div>
                <div class="text-center group">
                    <div class="w-20 h-20 bg-orange-100 text-orange-600 rounded-3xl flex items-center justify-center text-3xl mb-6 mx-auto group-hover:bg-orange-500 group-hover:text-white transition duration-500">4</div>
                    <h3 class="text-xl font-bold mb-2">Take Home</h3>
                    <p class="text-slate-500">Complete the paperwork and start your journey together!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Pet Care Tips -->
    <section id="tips" class="py-24 bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16">Pet Care Essentials</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="p-8 border border-slate-700 rounded-3xl hover:bg-slate-800 transition">
                    <i class="fas fa-utensils text-orange-400 text-4xl mb-6"></i>
                    <h3 class="text-xl font-bold mb-4">Nutrition</h3>
                    <p class="text-slate-400">High-quality protein-rich diets tailored to their age and size.</p>
                </div>
                <div class="p-8 border border-slate-700 rounded-3xl hover:bg-slate-800 transition">
                    <i class="fas fa-syringe text-orange-400 text-4xl mb-6"></i>
                    <h3 class="text-xl font-bold mb-4">Vaccination</h3>
                    <p class="text-slate-400">Keep up with regular vet checkups and immunization schedules.</p>
                </div>
                <div class="p-8 border border-slate-700 rounded-3xl hover:bg-slate-800 transition">
                    <i class="fas fa-soap text-orange-400 text-4xl mb-6"></i>
                    <h3 class="text-xl font-bold mb-4">Grooming</h3>
                    <p class="text-slate-400">Regular brushing and bathing keeps their coat healthy and shiny.</p>
                </div>
                <div class="p-8 border border-slate-700 rounded-3xl hover:bg-slate-800 transition">
                    <i class="fas fa-heart text-orange-400 text-4xl mb-6"></i>
                    <h3 class="text-xl font-bold mb-4">Attention</h3>
                    <p class="text-slate-400">Mental stimulation and daily exercise are vital for happiness.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. Success Stories -->
    <section id="success" class="py-24 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-16">Happy Tails</h2>
            <div class="grid md:grid-cols-2 gap-12">
                <div class="flex gap-6 p-8 bg-orange-50 rounded-[2.5rem]">
                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&q=80&w=300" class="w-32 h-32 rounded-3xl object-cover shadow-lg" alt="Happy owner">
                    <div>
                        <p class="italic text-slate-600 mb-4">"Adopting Oliver was the best decision. He fills our house with so much joy and laughter every single day!"</p>
                        <h4 class="font-bold">— Sarah & Oliver</h4>
                    </div>
                </div>
                <div class="flex gap-6 p-8 bg-orange-50 rounded-[2.5rem]">
                    <img src="https://images.unsplash.com/photo-1591768793355-74d04bb6608f?auto=format&fit=crop&q=80&w=300" class="w-32 h-32 rounded-3xl object-cover shadow-lg" alt="Happy owner">
                    <div>
                        <p class="italic text-slate-600 mb-4">"The process was so smooth. Luna has settled in perfectly and even gets along with our older cat."</p>
                        <h4 class="font-bold">— The Miller Family</h4>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 7. Donate Section -->
    <section id="donate" class="py-24">
        <div class="max-w-5xl mx-auto px-4 bg-gradient-to-r from-orange-500 to-red-500 rounded-[3rem] p-12 text-center text-white">
            <h2 class="text-4xl font-bold mb-6">Make a Difference Today</h2>
            <p class="text-xl mb-10 opacity-90">Your donation helps provide medical care, food, and shelter to animals in need.</p>
            <div class="flex flex-wrap justify-center gap-4">
                <button class="bg-white text-orange-600 px-10 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition">$25</button>
                <button class="bg-white text-orange-600 px-10 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition">$50</button>
                <button class="bg-white text-orange-600 px-10 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition">$100</button>
                <button class="bg-slate-900 text-white px-10 py-4 rounded-2xl font-bold text-lg hover:scale-105 transition">Custom Amount</button>
            </div>
        </div>
    </section>

    <!-- 8. Contact Section -->
    <footer id="contact" class="bg-slate-50 pt-24 pb-12">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid md:grid-cols-2 gap-16 mb-16">
                <div>
                    <h2 class="text-4xl font-bold mb-6">Get in Touch</h2>
                    <p class="text-slate-500 mb-8">Have questions about adoption? Our team is here to help you through every step of the journey.</p>
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-sm text-orange-500"><i class="fas fa-envelope"></i></div>
                            <span class="font-medium text-slate-700">hello@pawconnect.com</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-sm text-orange-500"><i class="fas fa-phone"></i></div>
                            <span class="font-medium text-slate-700">+1 (555) 123-4567</span>
                        </div>
                        <div class="flex gap-4 mt-8">
                            <a href="#" class="w-10 h-10 bg-slate-200 rounded-full flex items-center justify-center hover:bg-orange-500 hover:text-white transition"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="w-10 h-10 bg-slate-200 rounded-full flex items-center justify-center hover:bg-orange-500 hover:text-white transition"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="w-10 h-10 bg-slate-200 rounded-full flex items-center justify-center hover:bg-orange-500 hover:text-white transition"><i class="fab fa-twitter"></i></a>
                        </div>
                    </div>
                </div>
                <form class="bg-white p-8 rounded-[2rem] shadow-xl space-y-4">
                    <input type="text" placeholder="Your Name" class="w-full p-4 bg-slate-50 border-none rounded-xl focus:ring-2 focus:ring-orange-500 outline-none">
                    <input type="email" placeholder="Email Address" class="w-full p-4 bg-slate-50 border-none rounded-xl focus:ring-2 focus:ring-orange-500 outline-none">
                    <textarea placeholder="Your Message" rows="4" class="w-full p-4 bg-slate-50 border-none rounded-xl focus:ring-2 focus:ring-orange-500 outline-none"></textarea>
                    <button class="w-full bg-orange-500 text-white py-4 rounded-xl font-bold shadow-lg shadow-orange-200 hover:bg-orange-600 transition">Send Message</button>
                </form>
            </div>
            <div class="border-t border-slate-200 pt-8 text-center text-slate-400 text-sm">
                <p>&copy; 2023 PawConnect. Made with ❤️ for animals everywhere.</p>
            </div>
        </div>
    </footer>

</body>
</html>
